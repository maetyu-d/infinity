# The unmodified shader binaries are from the exact same pin as bgfx itself.
# Embed them at configure time so the executable is independently relocatable.
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
set(shader_header "// Generated from pinned bgfx binaries; bgfx BSD-2-Clause applies.\n#pragma once\n#include <cstdint>\n")
foreach(backend IN ITEMS metal glsl essl spirv dxbc)
  foreach(stage IN ITEMS vs fs)
    set(path "${BGFX_DIR}/examples/runtime/shaders/${backend}/${stage}_instancing.bin")
    file(READ "${path}" bytes HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    string(APPEND shader_header "static const uint8_t ${stage}_instance_${backend}[] = {${bytes}};\n")
  endforeach()
endforeach()
set(path "${CMAKE_BINARY_DIR}/generated/InstanceShaders.hpp")
if(EXISTS "${path}")
  file(READ "${path}" old_shader_header)
endif()
if(NOT old_shader_header STREQUAL shader_header)
  file(WRITE "${path}" "${shader_header}")
endif()
