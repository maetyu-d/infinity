foreach(dep IN ITEMS SDL glm FastNoise2 FastSIMD oneTBB zstd bgfx.cmake bx bimg bgfx)
  if(NOT EXISTS "${PROJECT_SOURCE_DIR}/external/${dep}")
    message(FATAL_ERROR "Missing ${dep}. Run: python3 tools/bootstrap.py")
  endif()
endforeach()
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(GLM_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(GLM_BUILD_LIBRARY OFF CACHE BOOL "" FORCE)
add_subdirectory(external/glm EXCLUDE_FROM_ALL)
set(FASTNOISE2_TOOLS OFF CACHE BOOL "" FORCE)
set(FASTNOISE2_TESTS OFF CACHE BOOL "" FORCE)
set(FASTNOISE2_STRICT_FP ON CACHE BOOL "" FORCE)
set(CPM_FastSIMD_SOURCE "${PROJECT_SOURCE_DIR}/external/FastSIMD" CACHE PATH "" FORCE)
add_subdirectory(external/FastNoise2 EXCLUDE_FROM_ALL)
set(TBB_TEST OFF CACHE BOOL "" FORCE)
set(TBB_STRICT OFF CACHE BOOL "" FORCE)
set(TBBMALLOC_BUILD OFF CACHE BOOL "" FORCE)
set(TBB_ENABLE_IPO OFF CACHE BOOL "" FORCE)
add_subdirectory(external/oneTBB EXCLUDE_FROM_ALL)
set(ZSTD_BUILD_PROGRAMS OFF CACHE BOOL "" FORCE)
set(ZSTD_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(ZSTD_BUILD_SHARED OFF CACHE BOOL "" FORCE)
add_subdirectory(external/zstd/build/cmake EXCLUDE_FROM_ALL)
find_package(SQLite3 3.35 REQUIRED)
if(INFINITE_VIEWER)
  set(SDL_SHARED OFF CACHE BOOL "" FORCE)
  set(SDL_STATIC ON CACHE BOOL "" FORCE)
  set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
  set(SDL_TESTS OFF CACHE BOOL "" FORCE)
  set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
  foreach(feature IN ITEMS AUDIO RENDER GPU JOYSTICK HAPTIC SENSOR CAMERA)
    set(SDL_${feature} OFF CACHE BOOL "" FORCE)
  endforeach()
  add_subdirectory(external/SDL EXCLUDE_FROM_ALL)
  set(BGFX_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
  set(BGFX_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
  set(BGFX_BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(BGFX_INSTALL OFF CACHE BOOL "" FORCE)
  set(BGFX_WITH_WAYLAND OFF CACHE BOOL "" FORCE)
  set(BGFX_CONFIG_VIDEO OFF CACHE BOOL "" FORCE)
  set(BX_DIR "${PROJECT_SOURCE_DIR}/external/bx" CACHE PATH "" FORCE)
  set(BIMG_DIR "${PROJECT_SOURCE_DIR}/external/bimg" CACHE PATH "" FORCE)
  set(BGFX_DIR "${PROJECT_SOURCE_DIR}/external/bgfx" CACHE PATH "" FORCE)
  add_subdirectory(external/bgfx.cmake EXCLUDE_FROM_ALL)
  target_compile_definitions(bgfx PRIVATE BGFX_CONFIG_RENDERER_WEBGPU=0)
  # Defining any renderer switch disables bgfx's automatic platform defaults.
  if(APPLE)
    target_compile_definitions(bgfx PRIVATE BGFX_CONFIG_RENDERER_METAL=1)
  elseif(WIN32)
    target_compile_definitions(bgfx PRIVATE BGFX_CONFIG_RENDERER_DIRECT3D11=1)
  else()
    target_compile_definitions(bgfx PRIVATE BGFX_CONFIG_RENDERER_VULKAN=1)
  endif()
endif()
