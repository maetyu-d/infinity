set(hyperion_header "// Generated from the source-traced Hyperion presentation shaders.\n#pragma once\n#include <cstdint>\n")
file(READ "${PROJECT_SOURCE_DIR}/shaders/manifest.json" hyperion_manifest)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/shaders/manifest.json")
foreach(group IN ITEMS sources binaries)
  string(JSON count LENGTH "${hyperion_manifest}" "${group}")
  math(EXPR last "${count}-1")
  foreach(i RANGE 0 ${last})
    string(JSON path MEMBER "${hyperion_manifest}" "${group}" ${i})
    string(JSON expected GET "${hyperion_manifest}" "${group}" "${path}")
    file(SHA256 "${PROJECT_SOURCE_DIR}/${path}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Stale Hyperion shader ${path}. Regenerate with tools/compile_shaders.py --shaderc /path/to/pinned/shaderc")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${path}")
  endforeach()
endforeach()
file(GLOB_RECURSE hyperion_binaries CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/shaders/bin/*.bin")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${hyperion_binaries})
foreach(path IN LISTS hyperion_binaries)
  get_filename_component(backend_dir "${path}" DIRECTORY)
  get_filename_component(backend "${backend_dir}" NAME)
  get_filename_component(name "${path}" NAME_WE)
  file(READ "${path}" bytes HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
  string(APPEND hyperion_header "static const uint8_t ${name}_${backend}[] = {${bytes}};\n")
endforeach()
set(path "${CMAKE_BINARY_DIR}/generated/HyperionShaders.hpp")
if(EXISTS "${path}")
  file(READ "${path}" previous_hyperion_header)
endif()
if(NOT previous_hyperion_header STREQUAL hyperion_header)
  file(WRITE "${path}" "${hyperion_header}")
endif()
